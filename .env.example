# Copy to .env and fill in. NEVER commit .env.
AWS_REGION=us-east-1
TERRAFORM_DIR=./terraform

# Approval TTL (minutes) — how long a `python approve.py <action>` stays valid
APPROVAL_TTL_MINUTES=30

# LLM for the CrewAI narrated path (optional — run.py works without it).
# e.g. Groq / OpenRouter. CREWAI_LLM picks the model.
CREWAI_LLM=groq/llama-3.1-8b-instant
GROQ_API_KEY=your-groq-api-key
